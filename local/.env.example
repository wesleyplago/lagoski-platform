# Copie para local/.env (ignorado pelo git). Usado só pelo serviço payment.
#
# Chave RESTRITA de um sandbox do Stripe (rk_test_...) com escrita em
# Checkout Sessions e Refunds. O serviço recusa chaves live.
STRIPE_API_KEY=rk_test_replace_me
# Rode no host:  stripe listen --forward-to localhost:8084/webhooks/stripe
# e copie o whsec_... que ele imprime.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
